# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production environment.
# NEVER commit .env with real production secrets to version control.

# Application
APP_NAME="University Bus Management System"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bus_system

# JWT Authentication
JWT_SECRET_KEY=ra7al-dev-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting ("memory" for local dev, "redis" for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
# Options: "local" (default for local/Docker development) or "supabase" (for production/Vercel)
STORAGE_BACKEND=local

# Supabase Storage (Required when STORAGE_BACKEND=supabase)
# NOTE: The service-role key must ONLY be used on the server side and NEVER exposed to clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=id-cards
# Private bucket dedicated to bus images (must exist in the Supabase project)
SUPABASE_BUS_IMAGES_BUCKET=bus-images
# Private bucket dedicated to digital payment receipt images (must exist in the
# Supabase project). Receipts are only served through authorized backend
# endpoints with short-lived signed access — never public URLs.
SUPABASE_PAYMENT_RECEIPTS_BUCKET=payment-receipts

# Security & Network
TRUSTED_PROXIES=127.0.0.1,::1,testclient
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
